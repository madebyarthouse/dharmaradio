{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "2c9fb1653ddb6954dedcb6ece9f5affe",
  "name": "dharmaradio",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./build/client"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 300000
  },
  "triggers": {
    "crons": ["0 */6 * * *", "0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dharmaradio",
      "database_id": "734fc32e-ec13-439e-b211-d9131fc1bf96",
      "migrations_dir": "./app/db/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "DB_QUERY_CACHE",
      "id": "c6b2f2e807e845568a563a5ec0781cee",
      "preview_id": "c6b656625d1a4f3cb3cfab85c88e880d"
    }
  ]
}
